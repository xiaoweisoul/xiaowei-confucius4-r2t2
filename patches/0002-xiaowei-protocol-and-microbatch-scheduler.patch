+# coding=utf-8
+"""R2T2 ASR 解码调度器 v3:微批合批(xiaowei 协议路由专用)。
+
+演进史(三版,教训都在这):
+- v1 单 worker 串行:安全,但 8 路并发 queue_wait P95=117ms 超标
+  (8 路 × 17ms/块 的排队是数学上限)。
+- v2 多 worker 并行:实测 vLLM V1 同步 LLM.generate **线程不安全**,
+  并发调用触发 EngineCore 崩溃(Assertion failed: !_current_out,
+  router.cpp:166),整个服务挂死 → 弃用。
+- v3(本版)微批合批:回到单 worker,但窗口内(默认 15ms)收集多路
+  job,通过 r2t2_asr.batch_streaming_decode_step 合成**一次**
+  generate([inp1, inp2, ...]) 调用——由 vLLM 连续批处理在引擎内部
+  并行消化多路,线程安全(单线程调用)且吞吐高(批推理)。
+  这正是 funasr asr_decode_scheduler 的原版设计思路。
+
+worker 里的执行体不再是"每 job 一个闭包",而是"攒一批 → 一次批量调用
+→ 按序分发结果"。partial 去重(completed 优先级)语义保留:
+- high(completed/finish)任务插队语义弱化为"先于窗口内 partial 执行"
+  (跨批不等待:有 high 任务时立刻收窗口)。
+
+接口变化(对路由):
+decode_batch(jobs) 提交一个会话本块的全部信息(state/audio/budget),
+调度器按 partial_key 去重后在 worker 里与其他会话合批。
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import time
+import uuid
+from collections import OrderedDict, deque
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import dataclass, field
+from typing import Any, Callable, Deque, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class ASRDecodeJob:
+    """一个待解码任务:携带批量化所需的三元组,由 batch API 消费。
+
+    decode_payload = (vad_instance, asr_state, pcm16k, max_new_tokens)
+    worker 不修改 payload 内容,只透传给 batch_fn。
+    字段顺序注意:dataclass 无默认值字段必须在有默认值字段之前。
+    """
+
+    job_id: str
+    job_type: str  # "user_partial" | "completed"
+    submitted_ts: float
+    future: "asyncio.Future"
+    decode_fn: Optional[Callable[[], Any]] = None  # completed 类任务的单会话闭包
+    decode_payload: Optional[tuple] = None  # partial 类任务的批量四元组
+    partial_key: str = ""
+    cancelled: bool = False
+
+
+class ASRDecodeScheduler:
+    """微批解码调度器:单 worker 线程 + 15ms 收集窗口 + 合批 generate。
+
+    并发边界:
+    - 全进程唯一 executor(max_workers=1):vLLM 同步引擎只被这一个
+      线程调用(线程安全,2026-09-21 v2 版崩溃教训)。
+    - asyncio 侧经 run_in_executor 提交,事件循环零阻塞。
+    - 同 partial_key 去重:窗口等待期间同会话新块覆盖旧块(音频在涨,
+      旧快照过时),旧 job 返回 None。
+    """
+
+    def __init__(self, micro_batch_wait_ms: int = 15) -> None:
+        self.micro_batch_wait_ms = max(0, int(micro_batch_wait_ms))
+        self.executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="r2t2-decode")
+        self.loop: Optional[asyncio.AbstractEventLoop] = None
+        self.high_jobs: Optional[Deque[ASRDecodeJob]] = None
+        self.partial_jobs: Optional["OrderedDict[str, ASRDecodeJob]"] = None
+        self.latest_partial_jobs: Dict[str, ASRDecodeJob] = {}
+        self.job_event: Optional[asyncio.Event] = None
+        self.worker_task: Optional[asyncio.Task] = None
+        self.closed = False
+        # worker 线程里执行批量调用的入口,由使用方(路由装配处)注入:
+        # batch_fn(jobs_payloads) -> results(与输入等长)
+        self.batch_fn: Optional[Callable[[list], list]] = None
+
+    # ---- 生命周期 ----
+
+    def _ensure_worker(self) -> None:
+        loop = asyncio.get_running_loop()
+        if self.loop is not None and self.loop is not loop:
+            raise RuntimeError("ASRDecodeScheduler can only be used by one asyncio loop")
+        if self.worker_task is not None:
+            return
+        self.loop = loop
+        self.high_jobs = deque()
+        self.partial_jobs = OrderedDict()
+        self.job_event = asyncio.Event()
+        self.worker_task = loop.create_task(self._worker_loop())
+        logger.info("ASRDecodeScheduler started (micro_batch_wait_ms=%s)",
+                    self.micro_batch_wait_ms)
+
+    def shutdown(self) -> None:
+        self.closed = True
+        if self.worker_task is not None:
+            self.worker_task.cancel()
+        if self.partial_jobs is not None:
+            for job in list(self.partial_jobs.values()):
+                self._set_empty_result(job)
+            self.partial_jobs.clear()
+        self.latest_partial_jobs.clear()
+        if self.high_jobs is not None:
+            while self.high_jobs:
+                self._set_empty_result(self.high_jobs.popleft())
+        self.executor.shutdown(wait=False)
+        logger.info("ASRDecodeScheduler shutdown")
+
+    # ---- 内部 ----
+
+    def _queue_depth(self) -> int:
+        high = len(self.high_jobs) if self.high_jobs is not None else 0
+        part = len(self.partial_jobs) if self.partial_jobs is not None else 0
+        return high + part
+
+    def _set_empty_result(self, job: ASRDecodeJob) -> None:
+        if not job.future.done():
+            job.future.set_result(None)
+
+    def _remove_latest_partial(self, job: ASRDecodeJob) -> None:
+        if job.job_type != "user_partial":
+            return
+        if self.latest_partial_jobs.get(job.partial_key) is job:
+            self.latest_partial_jobs.pop(job.partial_key, None)
+
+    def _drop_if_cancelled(self, job: ASRDecodeJob) -> bool:
+        if not job.cancelled and not job.future.done():
+            return False
+        self._remove_latest_partial(job)
+        logger.info("decode_job_dropped job_id=%s job_type=%s drop_reason=cancelled queue_depth=%s",
+                    job.job_id, job.job_type, self._queue_depth())
+        return True
+
+    # ---- 执行 ----
+
+    def _run_sync(self, high_job: Optional[ASRDecodeJob],
+                  batch_payloads: List[tuple], batch_jobs: List[ASRDecodeJob]) -> None:
+        """worker 线程执行体:先跑高优单会话任务,再跑合批任务。
+
+        high 任务(finish/段收口)单独执行:它们依赖 state 的终态语义,
+        不与其他会话的 partial 混批(收口预算大,混批会拉长整批延迟)。
+        """
+        if high_job is not None:
+            try:
+                result = high_job.decode_fn()
+                if not high_job.future.done():
+                    high_job.future.set_result(result)
+            except Exception:
+                logger.exception("decode_job_failed job_id=%s job_type=%s",
+                                 high_job.job_id, high_job.job_type)
+                if not high_job.future.done():
+                    high_job.future.set_exception(
+                        RuntimeError(f"decode failed for job {high_job.job_id}"))
+        if not batch_payloads:
+            return
+        batch_start = time.perf_counter()
+        try:
+            results = self.batch_fn(batch_payloads)
+        except Exception:
+            logger.exception("decode_batch_failed size=%s", len(batch_payloads))
+            results = [None] * len(batch_payloads)
+        inference_ms = int((time.perf_counter() - batch_start) * 1000)
+        logger.info("decode_batch size=%s inference_ms=%s", len(batch_payloads), inference_ms)
+        for job, result in zip(batch_jobs, results):
+            self._remove_latest_partial(job)
+            if not job.future.done():
+                job.future.set_result(result)
+
+    async def _worker_loop(self) -> None:
+        """单 worker:高优任务立即执行;partial 攒窗口合批。
+
+        窗口逻辑:取到 partial 队头后等 micro_batch_wait_ms,让同时刻
+        到达的其他会话的块进同批;窗口期间若有 high 任务到达,high
+        优先(本轮先跑 high,partial 顺延)。
+        """
+        while not self.closed:
+            await self.job_event.wait()
+            while not self.closed:
+                # 1) 高优任务零等待执行
+                while self.high_jobs and not self.closed:
+                    job = self.high_jobs.popleft()
+                    if self._drop_if_cancelled(job):
+                        continue
+                    await self._run_in_executor(job, [], [])
+                    break
+
+                # 2) partial:收窗口合批
+                if not self.partial_jobs:
+                    self.job_event.clear()
+                    if not self.high_jobs:
+                        break
+                    continue
+                if self.micro_batch_wait_ms > 0:
+                    await asyncio.sleep(self.micro_batch_wait_ms / 1000)
+                # 高优插队:窗口刚开时来了收口任务,先跑它
+                if self.high_jobs:
+                    continue
+
+                batch_jobs: List[ASRDecodeJob] = []
+                batch_payloads: List[tuple] = []
+                while self.partial_jobs and len(batch_jobs) < 32:
+                    _key, job = self.partial_jobs.popitem(last=False)
+                    if self._drop_if_cancelled(job):
+                        continue
+                    batch_jobs.append(job)
+                    batch_payloads.append(job.decode_payload)
+                if not batch_jobs:
+                    continue
+                await self._run_in_executor(None, batch_payloads, batch_jobs)
+
+    async def _run_in_executor(self, high_job, batch_payloads, batch_jobs) -> None:
+        submitted = [j.submitted_ts for j in batch_jobs]
+        if high_job is not None:
+            submitted.append(high_job.submitted_ts)
+        run_start = time.perf_counter()
+        await self.loop.run_in_executor(
+            self.executor, self._run_sync, high_job, batch_payloads, batch_jobs)
+        finished = time.perf_counter()
+        for j, ts in zip(batch_jobs, submitted):
+            logger.info("decode_job_finished job_id=%s job_type=%s queue_wait_ms=%s "
+                        "total_decode_ms=%s queue_depth=%s",
+                        j.job_id, j.job_type, int((run_start - ts) * 1000),
+                        int((finished - ts) * 1000), self._queue_depth())
+        if high_job is not None:
+            logger.info("decode_job_finished job_id=%s job_type=completed queue_wait_ms=%s "
+                        "total_decode_ms=%s",
+                        high_job.job_id, int((run_start - high_job.submitted_ts) * 1000),
+                        int((finished - high_job.submitted_ts) * 1000))
+
+    # ---- 对外接口 ----
+
+    async def decode(self, *, job_type: str, decode_fn: Callable[[], Any] = None,
+                     decode_payload: tuple = None, partial_key: str = "") -> Any:
+        """提交解码并等待结果。
+
+        - job_type="user_partial":decode_payload=(state, pcm, budget),
+          走合批路径;同 partial_key 新任务取消旧任务(返回 None)。
+        - job_type="completed":decode_fn=单会话闭包,高优先级立即执行。
+        """
+        if self.closed:
+            return None
+        if job_type == "user_partial" and self.batch_fn is None:
+            raise RuntimeError("batch_fn not configured for partial jobs")
+
+        self._ensure_worker()
+        loop = asyncio.get_running_loop()
+        job = ASRDecodeJob(
+            job_id=uuid.uuid4().hex[:16],
+            job_type=job_type,
+            submitted_ts=time.perf_counter(),
+            future=loop.create_future(),
+            decode_fn=decode_fn,
+            decode_payload=decode_payload,
+            partial_key=partial_key,
+        )
+
+        if job_type == "user_partial":
+            old_job = self.latest_partial_jobs.get(partial_key)
+            if old_job is not None and old_job is not job:
+                old_job.cancelled = True
+                self._set_empty_result(old_job)
+                self.partial_jobs.pop(partial_key, None)
+                logger.info("decode_job_superseded old_job_id=%s new_job_id=%s partial_key=%s",
+                            old_job.job_id, job.job_id, partial_key)
+            self.partial_jobs[partial_key] = job
+            self.latest_partial_jobs[partial_key] = job
+        else:
+            self.high_jobs.append(job)
+
+        self.job_event.set()
+        try:
+            return await job.future
+        except asyncio.CancelledError:
+            job.cancelled = True
+            if job.job_type == "user_partial":
+                if self.partial_jobs.get(partial_key) is job:
+                    self.partial_jobs.pop(partial_key, None)
+                if self.latest_partial_jobs.get(partial_key) is job:
+                    self.latest_partial_jobs.pop(partial_key, None)
+            logger.info("decode_job_dropped job_id=%s job_type=%s drop_reason=caller_cancelled",
+                        job.job_id, job.job_type)
+            raise
diff --git a/r2t2/r2t2_asr.py b/r2t2/r2t2_asr.py
index 9967217..8083dc3 100644
--- a/r2t2/r2t2_asr.py
+++ b/r2t2/r2t2_asr.py
@@ -577,6 +577,175 @@ class R2T2ASRModel(Qwen3ASRModel):
         print(f"finish state.text={state.text}")
         return state.text
 
+    # ---- 批量流式解码(xiaowei 协议路由专用,v0/v1 不使用) ----
+    # 动机(2026-09-21 压测):多线程并发调 vLLM generate → EngineCore 崩溃;
+    # 单线程逐路串行 → 8 路排队 P95=117ms 超标。generate 本身接受输入
+    # 列表,把 N 路组装好的输入合一次调用,由 vLLM 连续批处理并行消化。
+    # 拆分方式:单会话版循环体 = 组输入 | generate | 应用输出 三段,
+    # 前后两段无 GPU 且只碰各自 state;中间 generate 批量化。
+    # 以下代码从 streaming_transcribe_no_reset 复制,勿手改——上游更新
+    # 时以它为基准同步,保证 v0/v1 与 xiaowei 路由行为一致。
+
+    def _batch_consume_chunk(self, state, pcm16k):
+        """组输入段:消费 buffer 一个完整块,返回 vLLM inp(或 None)。
+
+        复制自单会话版:16s 滑窗裁剪 + rollback prefix + prompt 拼接。
+        只读改单会话 state,无 GPU;调度器单 worker 串行调用。
+        """
+        x = np.asarray(pcm16k)
+        if x.ndim != 1:
+            x = x.reshape(-1)
+        if x.dtype == np.int16:
+            x = (x.astype(np.float32) / 32768.0)
+        else:
+            x = x.astype(np.float32, copy=False)
+        if x.shape[0] > 0:
+            state.buffer = np.concatenate([state.buffer, x], axis=0)
+        if state.buffer.shape[0] < state.chunk_size_samples:
+            return None
+
+        chunk = state.buffer[: state.chunk_size_samples]
+        state.buffer = state.buffer[state.chunk_size_samples:]
+        if state.audio_accum.shape[0] == 0:
+            state.audio_accum = chunk
+        else:
+            state.audio_accum = np.concatenate([state.audio_accum, chunk], axis=0)
+
+        max_samples = 16 * SAMPLE_RATE
+        discard_samples = 8 * SAMPLE_RATE
+        if state.audio_accum.shape[0] > max_samples:
+            keep_samples = state.audio_accum.shape[0] - discard_samples
+            normal_chunk_samples = 2560
+            if not state._first_chunk_discarded:
+                first_chunk_samples = 5120
+                discard_chunks = 1 + (discard_samples - first_chunk_samples) // normal_chunk_samples
+                state._first_chunk_discarded = True
+            else:
+                discard_chunks = discard_samples // normal_chunk_samples
+            state.audio_accum = state.audio_accum[-keep_samples:]
+            state.chunk_text = state.chunk_text[discard_chunks:]
+
+        prefix_text = "".join(state.chunk_text)
+        if state.force_language == None and state.language != "":
+            prefix = f"language {state.language}<asr_text>" + prefix_text
+        else:
+            prefix = prefix_text
+        prefix = prefix.split("|")[0]
+        prompt = state.prompt_raw + prefix
+        return {"prompt": prompt, "multi_modal_data": {"audio": [state.audio_accum]}}
+
+    def _batch_apply_output(self, state, gen_text, rollback_punctuation=False):
+        """应用输出段:把 gen_text 解析回 state(与单会话版逐行一致)。
+
+        返回 None(与单会话版"该块无有效输出 continue"语义一致);
+        正常时更新 state.text/last_fixed_text/chunk_text/chunk_id。
+        """
+        gen_text = _normalize_punct_by_context(gen_text).replace('\ufffd', '')
+        prefix_text = "".join(state.chunk_text)
+        if state.force_language == None and state.language != "":
+            prefix = f"language {state.language}<asr_text>" + prefix_text
+        else:
+            prefix = prefix_text
+        prefix = prefix.split("|")[0]
+
+        state._raw_decoded = (prefix + gen_text) if prefix is not None else gen_text
+
+        if state.force_language == None:
+            lang,_ = parse_language_output(state._raw_decoded, user_language=state.force_language)
+
+        if state.force_language == "Chinese" or lang == "Chinese":
+            state._raw_decoded = re.sub(r'(?<=[\u4e00-\u9fff])\s+(?=[\u4e00-\u9fff])', '', state._raw_decoded)
+        lang, txt = parse_asr_output(state._raw_decoded, user_language=state.force_language)
+        has_tag = "<asr_text>" in state._raw_decoded
+        if has_tag:
+            state._raw_decoded = state._raw_decoded.split("<asr_text>")[0] + "<asr_text>" + txt
+        else:
+            state._raw_decoded = txt
+
+        state._raw_decoded = state._raw_decoded.split("|")[0]
+        cur_ids = self.processor.tokenizer.encode(state._raw_decoded)
+        if rollback_punctuation == True:
+            _punct = "，。！？、；：,.!?;:"
+            raw_stripped = state._raw_decoded.strip()
+            if raw_stripped and raw_stripped[-1] in _punct:
+                k = 0
+            else:
+                k = int(state.unfixed_token_num)
+        else:
+            k = int(state.unfixed_token_num)
+
+        has_tag = "<asr_text>" in state._raw_decoded
+        if has_tag and state._raw_decoded.split('<asr_text>')[1] == "":
+            k = 0
+        while True:
+            end_idx = max(0, len(cur_ids) - k)
+            fixed_text = self.processor.tokenizer.decode(cur_ids[:end_idx]) if end_idx > 0 else ""
+            if '\ufffd' not in fixed_text:
+                break
+            else:
+                if end_idx == 0:
+                    fixed_text = ""
+                    break
+                k += 1
+        has_tag = "<asr_text>" in fixed_text
+        if has_tag:
+            meta_part, fixed_text  = fixed_text.split("<asr_text>", 1)
+
+        has_tag = "<asr_text>" in state._raw_decoded
+        if not has_tag and state.force_language == None:
+            # 单会话版此处 continue 丢弃整块;xiaowei 路由语言恒显式,
+            # 该分支理论上不达;保留防御(返回 None 表示无有效输出)。
+            return None
+
+        state.language = lang
+        state.text = txt.split("|")[0]
+
+        state.chunk_id += 1
+        prefix_stripped = prefix_text.strip()
+        fixed_text_stripped = fixed_text.strip()
+        if fixed_text_stripped.startswith(prefix_stripped):
+            new_asr_text = fixed_text_stripped[len(prefix_stripped):]
+        else:
+            new_asr_text = ""
+        new_asr_text = new_asr_text.split("|")[0]
+        state.chunk_text.append(new_asr_text)
+        state.last_fixed_text = state.last_fixed_text + new_asr_text
+        return (state.text, state.last_fixed_text)
+
+    def batch_streaming_decode_step(self, jobs):
+        """批量解码入口:jobs = [(state, pcm16k, max_new_tokens), ...]。
+
+        全部在调用方线程(调度器 worker)执行:
+        1) 各会话 _batch_consume_chunk 组输入
+        2) 一次 model.generate(inputs, sampling_params=列表)
+        3) 各会话 _batch_apply_output 更新 state
+        返回与 jobs 等长列表:None(无块可解)或 (text, last_fixed_text)。
+        """
+        from vllm import SamplingParams
+
+        inputs = []
+        active = []
+        for idx, (state, pcm16k, max_new_tokens) in enumerate(jobs):
+            inp = self._batch_consume_chunk(state, pcm16k)
+            if inp is not None:
+                inputs.append(inp)
+                active.append((idx, state, max_new_tokens))
+
+        if not inputs:
+            return [None] * len(jobs)
+
+        sp_list = [
+            SamplingParams(temperature=0.0, max_tokens=max(1, int(b)) if b is not None else 2048,
+                           skip_special_tokens=True)
+            for _idx, _st, b in active
+        ]
+        outputs = self.model.generate(inputs, sampling_params=sp_list, use_tqdm=False)
+
+        results = [None] * len(jobs)
+        for (idx, state, _b), out in zip(active, outputs):
+            results[idx] = self._batch_apply_output(state, out.outputs[0].text)
+        return results
+
     def streaming_transcribe_no_reset(
         self,
         pcm16k: np.ndarray,
